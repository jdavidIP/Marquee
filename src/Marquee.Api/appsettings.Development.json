{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "Tracing": {
    "Enabled": true,
    "OtlpEndpoint": "http://localhost:4317",
    "SampleRatio": 1.0
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=marquee;Username=marquee;Password=marquee"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyTtlHours": 4,
    "OpenLockTtlSeconds": 15,
    "FriendGraphTtlHours": 12,
    "BlockStatusTtlSeconds": 30
  },
  "Realtime": {
    "BroadcastIntervalMs": 250
  },
  "Messaging": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "marquee",
    "Password": "marquee",
    "OutboxQueryDelaySeconds": 1,
    "DuplicateDetectionWindowMinutes": 30,
    "Retry": {
      "Limit": 5,
      "MinIntervalMs": 1000,
      "MaxIntervalMs": 30000,
      "IntervalDeltaMs": 2000
    }
  },
  "MarqueeSchedule": {
    "PremieresPerDay": 4,
    "DayStartHour": 7,
    "DayEndHour": 23,
    "MinimumGapMinutes": 120,
    "DurationMinutes": 60
  },
  "Scheduler": {
    "Enabled": true,
    "DailyGenerationCron": "0 5 0 * * ?",
    "TickIntervalSeconds": 20,
    "StartupDelaySeconds": 10,
    "GenerateDaysAhead": 2
  },
  "Jwt": {
    "Key": "dev-only-super-secret-signing-key-change-me-please-32+chars",
    "Issuer": "marquee",
    "Audience": "marquee",
    "ExpiryHours": 24
  },
  "AnonymousSession": {
    "LifetimeMinutes": 180,
    "SigningKey": "",
    "HeaderName": "X-Anon-Session"
  },
  "ClapGuards": {
    "MinIntervalMs": 250,
    "IdempotencyTtlMinutes": 10,
    "MaxIdempotencyKeyLength": 128
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": { "PermitLimit": 300, "WindowSeconds": 60, "SegmentsPerWindow": 6, "QueueLimit": 0 },
    "Clap": { "PermitLimit": 120, "WindowSeconds": 60, "SegmentsPerWindow": 6, "QueueLimit": 0 },
    "SessionIssue": { "PermitLimit": 10, "WindowSeconds": 300, "SegmentsPerWindow": 5, "QueueLimit": 0 },
    "Auth": { "PermitLimit": 100, "WindowSeconds": 300, "SegmentsPerWindow": 5, "QueueLimit": 0 }
  },
  "Admin": {
    "Username": "admin",
    "Email": "admin@marquee.local",
    "Password": "seed-me-locally-1"
  },
  "Tmdb": {
    "ApiKey": ""
  },
  "Email": {
    "SmtpHost": ""
  }
}
