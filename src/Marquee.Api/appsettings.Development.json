{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=marquee;Username=marquee;Password=marquee"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyTtlHours": 4,
    "OpenLockTtlSeconds": 15
  },
  "Realtime": {
    "BroadcastIntervalMs": 250
  },
  "Messaging": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "marquee",
    "Password": "marquee",
    "OutboxQueryDelaySeconds": 1,
    "DuplicateDetectionWindowMinutes": 30,
    "Retry": {
      "Limit": 5,
      "MinIntervalMs": 1000,
      "MaxIntervalMs": 30000,
      "IntervalDeltaMs": 2000
    }
  },
  "MarqueeSchedule": {
    "PremieresPerDay": 4,
    "DayStartHour": 7,
    "DayEndHour": 23,
    "MinimumGapMinutes": 120,
    "DurationMinutes": 60
  },
  "Scheduler": {
    "Enabled": true,
    "DailyGenerationCron": "0 5 0 * * ?",
    "TickIntervalSeconds": 20,
    "StartupDelaySeconds": 10,
    "GenerateDaysAhead": 2
  },
  "Jwt": {
    "Key": "dev-only-super-secret-signing-key-change-me-please-32+chars",
    "Issuer": "marquee",
    "Audience": "marquee",
    "ExpiryHours": 24
  },
  "Admin": {
    "Username": "admin",
    "Email": "admin@marquee.local",
    "Password": "admin12345"
  },
  "Tmdb": {
    "ApiKey": ""
  }
}
