# Copy to .env and fill in. Never commit the real .env.
# TMDB API — https://www.themoviedb.org/settings/api (v4 read access token or v3 key)
TMDB__ApiKey=your-tmdb-v3-api-key-here

# JWT signing key — any long random string for local dev
Jwt__Key=change-me-to-a-long-random-secret-at-least-32-chars
