# Keys docker-compose.prod.yml expects in `.env` (on the host, written from SSM /marquee/prod/*).
# Never commit a filled-in copy.

# Image to run
REGISTRY=
IMAGE_TAG=

# Public URL of the site, e.g. https://d1234abcd.cloudfront.net
PUBLIC_BASE_URL=

# The Cognito user pool (MarqueeAuthStack outputs Issuer and UserPoolClientId). Not secrets.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# Infrastructure credentials (also interpolated into the api/worker connection settings)
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# App secrets, passed straight through to the api/worker. The API refuses to start in Production
# without Tmdb__ApiKey (else it would silently serve the offline stub), Admin__Password (else the
# seeded admin gets the repository's development password) and OriginVerify__Secret (else it would
# accept requests from any CloudFront distribution, not only Marquee's).
Jwt__Key=
Tmdb__ApiKey=
Admin__Password=
# Must match the X-Origin-Verify header CloudFront adds; a plain String in SSM, see DEPLOYMENT.md.
OriginVerify__Secret=
